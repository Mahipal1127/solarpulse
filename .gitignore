# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Instagram audit collector (tools/instagram-audit) — a LOCAL operator tool, never deployed.
# .profile/ is Chromium's own profile directory and holds a live logged-in Instagram
# session. Committing or sharing it would hand over access to the account as surely as
# handing over the password, so it is ignored here and must stay that way.
/tools/instagram-audit/.profile/
/tools/instagram-audit/node_modules/
# Collected payloads written by --out / --dry-run. Real post data; no reason to commit it.
/tools/instagram-audit/*-payload.json
